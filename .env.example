# Leave everything unset to run the demo offline against demo/fixtures.
# Set these and CHARTROOM live-calls the real Corti API.
CORTI_ENVIRONMENT=eu           # eu | us
CORTI_TENANT=your-tenant
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=

# The judge. Any OpenAI-compatible /chat/completions endpoint.
# Defaults to Corti Models when Corti creds are present.
CHARTROOM_LLM_BASE=
CHARTROOM_LLM_KEY=
CHARTROOM_LLM_MODEL=
